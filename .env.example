# ---------------------------------------------------------------------------
# Finance Close Control Agent - example configuration
#
# Copy to `.env` and adjust. `.env` is git-ignored.
# No credentials are read from this file: AWS and Google Cloud authentication
# use the native credential chains of each SDK (see README).
# ---------------------------------------------------------------------------

# Provider selection: mock | bedrock | vertex
# `mock` is the default and requires no cloud account.
LLM_PROVIDER=mock

# --- AWS Bedrock -----------------------------------------------------------
# Authentication: standard AWS credential chain (env vars, ~/.aws/credentials,
# SSO profile, IAM role). Do NOT put access keys in this file.
AWS_REGION=eu-central-1
# Any chat model enabled in your Bedrock account, e.g. an Anthropic, Meta,
# Mistral or Amazon Nova model id. Model access must be granted in the console.
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0

# --- Google Vertex AI ------------------------------------------------------
# Authentication: Application Default Credentials (`gcloud auth application-default login`)
# or an attached service account. Do NOT put a key file path with secrets in git.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_LOCATION=europe-west4
VERTEX_MODEL_NAME=gemini-2.5-flash

# --- Inference behaviour ---------------------------------------------------
FCCA_TEMPERATURE=0.0
FCCA_MAX_TOKENS=1200
FCCA_REQUEST_TIMEOUT_S=60
# json_schema_prompt = portable schema-in-prompt parsing (default)
# native_tools       = provider-native structured output via tool calling
FCCA_STRUCTURED_OUTPUT_MODE=json_schema_prompt

# --- Control thresholds ----------------------------------------------------
# Group materiality for the close cycle, in reporting currency.
FCCA_MATERIALITY_GROUP=250000
# Single-entry posting threshold requiring second-level approval.
FCCA_JOURNAL_APPROVAL_THRESHOLD=50000
# Clearly trivial threshold below which items are not escalated on amount alone.
FCCA_TRIVIAL_THRESHOLD=5000

# --- Human-in-the-loop gate ------------------------------------------------
FCCA_AUTO_APPROVE_MIN_CONFIDENCE=0.80
FCCA_AUTO_APPROVE_MIN_EVIDENCE=1

# --- Optional cost estimation (USD per 1M tokens; leave unset to skip) ------
# FCCA_INPUT_COST_PER_MTOK=3.00
# FCCA_OUTPUT_COST_PER_MTOK=15.00
